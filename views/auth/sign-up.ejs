<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign Up</title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>
  <%- include('../partials/navbar') %>
   
    <div style="width: 100%;display: flex; width: 100%; justify-content: center;">
      <form action="/auth/sign-up" method="post" style="width: 40em; background-color:#242329; padding:3em; margin: 0; border-radius: 15px;" >

        <div id="sign-up">
          <div>
            <label for="username">Username</label>
            <input type="text" name="username" id="username" placeholder="Enter your username" />
          </div>
          <br>
          <div>
            <label for="emil">email</label>
            <input type="text" name="email" id="email" placeholder="Enter your email" />
          </div>
          <br>
          <div>
            <label for="confirmPassword">Confirm Password</label>
            <input type="password" name="password" id="password" placeholder="Create a password" />
          </div>
          <br>
          <div>
            <label for="confirmPassword">Confirm Password</label>
            <input type="password" name="confirmPassword" id="confirmPassword" placeholder="Confirm your password" />
          </div>
          <br>
          <div>
            <label for="pfp">pick ur profile picture</label>
            <input type="text" name="pfp" id="pfp" placeholder="Enter a profile picture URL">
          </div>
          <br>
          <br>
          <button type="submit" id="sightUpButton">Sign up</button>
        </div>
      </form>
    </div>
</body>

</html>