<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include('./partials/navbar') %>

        <div style="margin: 3em;">
            <h2>most popular this month</h2>
            <div style="display: flex; gap: 2em;">
                <% for (let index=0; index < 5; index++) { %>
                    <div class="album-card">
                        <a href="/album/<%= allAlbums[index]._id %>"><img src="<%= allAlbums[index].cover_img %>"
                                alt="<%= allAlbums[index].name %>">
                        </a>
                        <h2 class="album-name">
                            <%= allAlbums[index].name %>
                        </h2>
                        <p class="album-artist">
                            <%= allAlbums[index].artist_id.name %>
                        </p>
                    </div>
                    <% } %>
            </div>
            <div>
                <% if (friendReviews !==undefined) {%>
                    <h2>Reviewed by Friends</h2>
                    <% for (let oneReview of friendReviews.slice(0, 3)) { %>
                        <div
                            style="background-color: #1C1B20; padding: 1em; display: flex; gap: 1em; border-radius: 15px; margin-bottom: 1em; width:  80%;">
                            <div style=" width:  100%; display: flex; justify-content: space-between;">
                                <div style="display: flex; gap: 2em;">
                                    <div>
                                        <a href="/album/<%=oneReview.album._id%>"><img
                                                src="<%=oneReview.album.cover_img%>" alt=""
                                                style="width: 10em; height: 10em; border-radius: 15px;"></a>
                                    </div>
                                    <div>
                                        <h3>
                                            <%=oneReview.album.name%>
                                        </h3>

                                        <%for (let oneArtist of artist){%>
                                            <%if (oneReview.album.artist_id.toString()===oneArtist._id.toString()){%>
                                                <p style="color: #aba5ad;">
                                                    <%=oneArtist.name%> . <%= new
                                                            Date(oneReview.album.release_date).getFullYear() %>
                                                            <span style="color: #ffc107;">
                                                                <%= '★' .repeat(Math.max(0,
                                                                    Math.floor(Number(oneReview.rating) || 0))) %>
                                                            </span>
                                                </p>
                                                <%}%>
                                                    <%}%>
                                                        <p>
                                                            <%=oneReview.review%>
                                                        </p>
                                    </div>
                                </div>
                                <div> <a href="/album/<%=oneReview.user._id%>"><img src="<%=oneReview.user.pfp%>" alt=""
                                            style="width: 8em; height: 8em; border-radius: 999px;"></a>
                                </div>
                            </div>
                        </div>

                        <%}%>
                            <%}%>
            </div>
            <div>
                <h1>profiles</h1>
                <div style="margin: 3em;display: flex;flex-direction: row;flex-wrap: wrap;justify-content: space-between; width: 80%;">
                    <%for (let oneUser of users.slice(0, 4)){%>
                        <div style="width: 20%;display: flex;flex-direction: column;align-items: center;">
                            <div
                                style="display: flex;flex-direction: column;align-content: center;align-items: center;">
                                <a href="/profile/<%= oneUser._id %>"><img src="<%=oneUser.pfp%>" alt=""
                                        style="width: 10em; height: 10em; border-radius: 200px;"></a>
                            </div>
                            <div style="display: flex;flex-direction: column;align-items: center;">
                                <h2 style="margin: 0; margin-top: 0.5em;">
                                    <%=oneUser.username%>
                                </h2>
                                <p style="color: #ABA5AD; margin: 0; margin-bottom: 1em;">
                                    <%= reviews.filter(r=> String(r.user) === String(oneUser._id)).length %> : reviews
                                </p>
                            </div>
                            <div
                                style="display: flex;flex-direction: column;align-content: center; flex-direction: row;justify-content: center; gap: 1em;width: 100%;">
                                <% const newestFavs=[...oneUser.fav].sort((a, b)=> Date.parse(b.createdAt) -
                                    Date.parse(a.createdAt));
                                    %>
                                    <% for (let i=0; i < Math.min(newestFavs.length, 3); i++) { const
                                        oneAlbum=newestFavs[i]; %>
                                        <img src="<%=oneAlbum.cover_img%>" alt="" style="width: 27%;">
                                        <% } %>

                            </div>
                        </div>
                        <%}%>
                </div>
            </div>
        </div>

</body>

</html>