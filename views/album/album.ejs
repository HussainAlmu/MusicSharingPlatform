<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script defer src="/js/album.js"></script>


    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include('../partials/navbar') %>
        <div style="display: flex;justify-content: center;">
            <form action="/album" method="GET" style="width: 50%;display: flex;justify-content: center;">
                <input type="text" id="searchBar" name="s" placeholder="Search for an Album..." style="width: 100%;">
            </form>
        </div>

        <div style="display: flex;margin: 1em;justify-content: center;gap: 2em;">
            <button class="serchButtons " type="button" id="next">next</button>
            <button class="serchButtons " type="button" id="previous">previous</button>
        </div>
        <div id="album-any" style="margin: 3em;display: flex;flex-wrap: wrap;flex-direction: row;gap: 2em;">

            <% for (let oneAlbum of album) { %>
                <div class="album-card">
                    <a href="/album/<%= oneAlbum._id %>"><img src="<%= oneAlbum.cover_img %>"
                            alt="<%= oneAlbum.name %>"> </a>
                    <h2 class="album-name">
                        <%= oneAlbum.name %>
                    </h2>
                    <p class="album-artist">
                        <%= oneAlbum.artist_id.name %>
                    </p>
                </div>
                <% } %>
        </div>
</body>

</html>