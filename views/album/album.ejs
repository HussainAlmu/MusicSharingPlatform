<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script defer src="/js/album.js"></script>


    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include('../partials/navbar') %>
        <form action="/album" method="GET" class="album-search-form" id="albumSearchForm">
                <input type="search" id="searchBar" name="s" value="<%= searchTerm %>"
                    placeholder="Search albums...">
                <input type="search" id="artistSearch" name="artist" value="<%= artistTerm %>"
                    list="artistOptions" placeholder="Search artists..." autocomplete="off">
                <datalist id="artistOptions">
                    <% for (let oneArtist of artists) { %>
                        <option value="<%= oneArtist.name %>"></option>
                    <% } %>
                </datalist>
        </form>

        <div style="display: flex;margin: 1em;justify-content: center;gap: 2em;">
            <button class="serchButtons " type="button" id="next">next</button>
            <button class="serchButtons " type="button" id="previous">previous</button>
        </div>
        <div id="album-any" style="margin: 3em;display: flex;flex-wrap: wrap;flex-direction: row;gap: 2em;">

            <% for (let oneAlbum of album) { %>
                <div class="album-card">
                    <a href="/album/<%= oneAlbum._id %>"><img src="<%= oneAlbum.cover_img %>"
                            alt="<%= oneAlbum.name %>"> </a>
                    <h2 class="album-name">
                        <%= oneAlbum.name %>
                    </h2>
                    <p class="album-artist">
                        <%= oneAlbum.artist_id.name %>
                    </p>
                </div>
                <% } %>
        </div>
</body>

</html>