<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/style.css">
    <script defer src="/js/create.js"></script>
</head>

<body>
    <form action="/album/create" method="POST">
        <div>
            <label for="name">Name:</label>
            <input type="text" id="name" name="name" required>
        </div>
        <div>
            <label for="cover_img">Cover Image URL:</label>
            <input type="text" id="cover_img" name="cover_img" required>
        </div>
        <div>
            <label for="release_date">Release Date:</label>
            <input type="date" id="release_date" name="release_date" required>
        </div>
        <div>
            <label for="genre">Genre:</label>
            <select id="genre" name="genre" required>
                <option value="">Select a genre</option>
                <% for (let oneGenre of genres) { %>
                    <option value="<%= oneGenre._id %>">
                        <%= oneGenre.name %>
                    </option>
                    <% } %>
            </select>
            <div id="genre-tag">

            </div>
        </div>
        <div>
            <label for="artist_id">Artist:</label>
            <select id="artist_id" name="artist_id" required>
                <option value="">Select an artist</option>
                <% for (let oneArtist of artists) { %>
                    <option value="<%= oneArtist._id %>">
                        <%= oneArtist.name %>
                    </option>
                    <% } %>
            </select>
        </div>
        <div>
            <label for="description">Description:</label>
            <textarea id="description" name="description"></textarea>
        </div>

        <button type="submit">Create Album</button>
    </form>
</body>

</html>