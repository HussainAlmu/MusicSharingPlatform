<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <script defer src="/js/review.js"></script>

</head>

<body>
    <%- include('../partials/navbar') %>

        <div id="album-details-top">
            <div id="album-details">
                <div>
                    <img src="<%=album.cover_img%>" alt="" style="width: 20em; height: 20em;">
                </div>
                <div>
                    <h1>
                        <%=album.name%>
                    </h1>
                    <p id="album-info">
                        Album &#8226; <%= new Date(album.release_date).toISOString().slice(0, 10) %> &#8226; <%=
                                songs.length %> tracks
                    </p>
                    <p>
                        <%= album.artist_id.name %>
                    </p>
                </div>
            </div>
            <% const averageRating = allReviews.length
                ? allReviews.reduce((sum, oneReview) => sum + Number(oneReview.rating || 0), 0) / allReviews.length
                : 0; %>
            <div style="width: 40%;">
                <div style="display: flex;gap: 3em;justify-content: center;">
                    <div style="text-align: center;">
                        <h2><%= allReviews.length %></h2>
                        <p>total reviews</p>
                    </div>
                    <div style="text-align: center;">
                        <h2><%= Math.round(averageRating) %>/5</h2>
                        <p>Average rating</p>
                    </div>
                    <% if (typeof review !== 'undefined' && review) { %>
                    <div style="text-align: center;">
                        <h2><%= review.rating %>/5</h2>
                        <p>your rating</p>
                    </div>
                    <% }else{ %>
                        <div style="text-align: center;">
                        <h2>0/5</h2>
                        <p>your rating</p>
                    </div>
                    <%}%>
                </div>
                <% if (typeof review !=='undefined' && review) { %>
                    <button id="editReviewButton">Edit Review</button>
                    <% } else { %>
                        <button id="review-button">Write Review</button>
                        <% } %>


            </div>
        </div>
        <div style="display: flex; justify-content: space-between;">

            <div style="padding: 2em 2em 0em 6em;width: 60%;">
                <div style="width: 100%; display: flex; justify-content: space-between;">
                    <h3>track list</h3>
                </div>
                <div
                    style="display: flex; width: 100%; justify-content: space-between;background-color: #1c1b20 ; padding: 0.5em 0em 0.5em 0em; border-radius: 8px;flex-direction: column;">
                    <% for (let oneSongs of songs) { %>
                        <div style="display: flex; justify-content: space-between; padding: 0.5em 0em 0.5em 0em;">

                            <div style="display: flex; gap: 1em; flex-direction: row; align-items: center;">
                                <div style="padding-left: 2em;">
                                    <p style="color: #ABA5AD;">
                                        <%=oneSongs.track_number%>
                                    </p>
                                </div>
                                <div>
                                    <p style="font-size: 1em; ">
                                        <%=oneSongs.song_name %>
                                    </p>
                                    <p style="font-size: 0.9em; color: #ABA5AD; line-height: 0;">
                                        <%= album.artist_id.name %>
                                    </p>
                                </div>
                            </div>
                            <div
                                style="display:flex; align-items:center; flex-direction: row; gap: 5em;padding-right: 2em;">
                                <p style="color: #ABA5AD;">
                                    <%=oneSongs.duration%>
                                </p>
                                <i style="font-size:24px" class="fa">&#xf144;</i>
                            </div>
                        </div>
                        <%}%>
                </div>

                <div>
                    <h3>reviews</h3>
                </div>
                <% if (typeof review !=='undefined' && review) { %>
                    <div style="width: 100%; background-color: #1c1b20; border-radius: 15px; ">
                        <div style="display: flex;gap: 1em;flex-direction: row;align-items: center; padding: 1em;">
                            <div>
                                <img src="<%=review.user.pfp%>" alt=""
                                    style="width: 6em; height: 6em;border-radius: 4em;">
                            </div>
                            <div>
                                <p style="color: #ABA5AD;">reviewed by <span style="color: white;">
                                        <%=review.user.username%>
                                    </span></p>
                                <p style="color: #ABA5AD;">Reviewed on <%= new
                                        Date(review.createdAt).toLocaleDateString() %>
                                </p>
                            </div>
                        </div>
                        <div style="padding: 0em 1em 0em 1em;">
                            <h3 style="margin: 0;">
                                <%=review.title%>
                            </h3>
                            <h3 aria-label="Rating: <%= review.rating %> out of 5"
                                style="color: #ffc107;margin-top: 0.2em;">
                                <% for (let star=1; star <=5; star++) { %>
                                    <% if (star <=review.rating) { %>
                                        <span style="color: #ffc107;">★</span>
                                        <% } else { %>
                                            <span style="color: #505050;">☆</span>
                                            <% } %>
                                                <% } %>
                            </h3>
                            <p style="padding-bottom: 1.5em; white-space:pre-wrap;"><%= review.review %>
                            </p>
                        </div>
                    </div>
                    <% } %>
                        <% for (let oneReview of allReviews) { %>
                            <% if (oneReview.user._id.toString()===review.user._id.toString()) continue; %>
                                <div style="width: 100%; background-color: #1c1b20; border-radius: 15px; ">
                                    <div
                                        style="display: flex;gap: 1em;flex-direction: row;align-items: center; padding: 1em;">
                                        <div>
                                            <img src="<%=oneReview.user.pfp%>" alt=""
                                                style="width: 6em; height: 6em;border-radius: 4em;">
                                        </div>
                                        <div>
                                            <p style="color: #ABA5AD;">reviewed by <span style="color: white;"><%=oneReview.user.username%></span></p>
                                            <p style="color: #ABA5AD;">Reviewed on <%= new
                                                    Date(oneReview.createdAt).toLocaleDateString() %>
                                            </p>
                                        </div>
                                    </div>
                                    <div style="padding: 0em 1em 0em 1em;">
                                        <h3 style="margin: 0;">
                                            <%=oneReview.title%>
                                        </h3>
                                        <h3 aria-label="Rating: <%= oneReview.rating %> out of 5"
                                            style="color: #ffc107;margin-top: 0.2em;">
                                            <% for (let star=1; star <=5; star++) { %>
                                                <% if (star <=oneReview.rating) { %>
                                                    <span style="color: #ffc107;">★</span>
                                                    <% } else { %>
                                                        <span style="color: #505050;">☆</span>
                                                        <% } %>
                                                            <% } %>
                                        </h3>
                                        <p style="padding-bottom: 1.5em; white-space:pre-wrap;"><%= oneReview.review %>
                                        </p>
                                    </div>
                                </div>
                                <% } %>
            </div>
            <div style="width: 30%; margin: 2em 6em 0em 0em; ">
                <div style="background-color: #1c1b20 ; border-radius: 15px;">
                    <button class="album-det-buttons">add album to list</button>
                    <button class="album-det-buttons">edit album</button>
                    <button class="album-det-buttons">delete album</button>
                    <button class="album-det-buttons"><i style="font-size:24px; margin-right: 0.5em;"
                            class="fa">&#xf144;</i>Liston on Streaming</button>

                </div>
                <h3>more of <%= album.artist_id.name %>
                </h3>
                <% for (let oneAlbum of albumByArtist) { %>
                    <% if (oneAlbum._id.toString() !==album._id.toString()) { %>
                        <a href="/album/<%= oneAlbum._id %>" style="color: inherit; text-decoration: none;">
                            <div
                                style="display:flex;gap:1em;align-items:center;background-color: #1c1b20; padding: 1em; border-radius: 15px;">
                                <div>

                                    <img src="<%=oneAlbum.cover_img%>" alt="" style="width: 5em;">

                                </div>
                                <div>
                                    <p style="margin: 0.5em 0em 0.5em 0em;">
                                        <%=oneAlbum.name%>
                                    </p>
                                    <p style="color: #ABA5AD; margin: 0;">Album &#8226; <%= new
                                            Date(oneAlbum.release_date).toISOString().slice(0, 10)%>
                                    </p>
                                </div>
                            </div>
                        </a>
                        <% } %>
                            <%}%>



            </div>
        </div>

        <div id="review-form">
            <div style="display: flex; gap: 3em;">
                <div>
                    <img src="<%=album.cover_img%>" alt="" style="width: 13em;">
                </div>
                <div style="width: 44em;">
                    <form action="/album/rate" method="POST">
                        <input type="hidden" name="page_id" value="<%= album._id %>">
                        <div>
                            <h2>
                                <%=album.name%>
                            </h2>
                            <p style="color: #ABA5AD;">
                                <%= album.artist_id.name %> • Album
                            </p>
                        </div>
                        <legend class="legend">Your rating</legend>
                        <div class="stars">
                            <input class="star-input" type="radio" name="rating" id="star1" value="1" required>
                            <label class="star-label" for="star1"><span class="visually-hidden">1 star</span><span
                                    aria-hidden="true">★</span></label>

                            <input class="star-input" type="radio" name="rating" id="star2" value="2" required>
                            <label class="star-label" for="star2"><span class="visually-hidden">2 stars</span><span
                                    aria-hidden="true">★</span></label>
                            <input class="star-input" type="radio" name="rating" id="star3" value="3" required>
                            <label class="star-label" for="star3"><span class="visually-hidden">3 star</span><span
                                    aria-hidden="true">★</span></label>

                            <input class="star-input" type="radio" name="rating" id="star4" value="4" required>
                            <label class="star-label" for="star4"><span class="visually-hidden">4 stars</span><span
                                    aria-hidden="true">★</span></label>
                            <input class="star-input" type="radio" name="rating" id="star5" value="5" required>
                            <label class="star-label" for="star5"><span class="visually-hidden">5 star</span><span
                                    aria-hidden="true">★</span></label>



                            <!-- stars 3, 4 and 5 follow the same pattern -->
                        </div>
                        <label for="title">Review title</label>
                        <input type="text" name="title" id="title">
                        <br>
                        <label for="review_text">Review</label>
                        <textarea name="review_text" id="review_text" rows="10" style="width: 100%;"></textarea>
                        <button type="submit" id="review-button">Submit</button>
                    </form>
                </div>
            </div>
        </div>
        <% if (typeof review !=='undefined' && review) { %>
            <div id="edit-review-form">
                <div style="display: flex; gap: 3em;">
                    <div>
                        <img src="<%=album.cover_img%>" alt="" style="width: 13em;">
                    </div>
                    <div style="width: 44em;">
                        <form action="/album/rate/edit" method="POST">
                            <input type="hidden" name="page_id" value="<%= album._id %>">
                            <div>
                                <h2>
                                    <%=album.name%>
                                </h2>
                                <p style="color: #ABA5AD;">
                                    <%= album.artist_id.name %> • Album
                                </p>
                            </div>
                            <legend class="legend">Your rating</legend>
                            <div class="stars">
                                <input class="star-input" type="radio" name="rating" id="edit-star1" value="1" required
                                    <%=review.rating==1 ? 'checked' : '' %>>
                                <label class="star-label" for="edit-star1"><span class="visually-hidden">1
                                        star</span><span aria-hidden="true">★</span></label>

                                <input class="star-input" type="radio" name="rating" id="edit-star2" value="2" required
                                    <%=review.rating==2 ? 'checked' : '' %>>
                                <label class="star-label" for="edit-star2"><span class="visually-hidden">2
                                        stars</span><span aria-hidden="true">★</span></label>
                                <input class="star-input" type="radio" name="rating" id="edit-star3" value="3" required
                                    <%=review.rating==3 ? 'checked' : '' %>>
                                <label class="star-label" for="edit-star3"><span class="visually-hidden">3
                                        star</span><span aria-hidden="true">★</span></label>

                                <input class="star-input" type="radio" name="rating" id="edit-star4" value="4" required
                                    <%=review.rating==4 ? 'checked' : '' %>>
                                <label class="star-label" for="edit-star4"><span class="visually-hidden">4
                                        stars</span><span aria-hidden="true">★</span></label>
                                <input class="star-input" type="radio" name="rating" id="edit-star5" value="5" required
                                    <%=review.rating==5 ? 'checked' : '' %>>
                                <label class="star-label" for="edit-star5"><span class="visually-hidden">5
                                        star</span><span aria-hidden="true">★</span></label>



                                <!-- stars 3, 4 and 5 follow the same pattern -->
                            </div>
                            <label for="title">Review title</label>
                            <input type="text" name="title" id="title" value="<%= review.title %>">
                            <br>
                            <label for="review_text">Review</label>
                            <textarea name="review_text" id="review_text" rows="10"
                                style="width: 100%;"><%= review.review%></textarea>
                            <button type="submit" id="review-button">Submit</button>
                        </form>
                    </div>
                </div>
            </div>
            <% } %>


</body>

</html>